<Window x:Class="Unread.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Unread.App"
 Title="Unread Reader">
  <Grid x:Name="Root" Background="{StaticResource ReaderBackground}" Loaded="OnLoaded" SizeChanged="OnSizeChanged">
    <Grid.Resources>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
      <Style x:Key="PaneResizerStyle" TargetType="local:PaneResizer">
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ReaderAccent}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="local:PaneResizer">
              <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Background" Value="{StaticResource ReaderAccent}" /><Setter Target="Grip.Opacity" Value="1" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Background" Value="{StaticResource ReaderAccent}" /><Setter Target="Grip.Opacity" Value="1" /></VisualState.Setters></VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Width="1" Background="{StaticResource ReaderDivider}" HorizontalAlignment="Center" />
                <Border x:Name="Grip" Width="3" Height="36" CornerRadius="1.5" Background="{StaticResource ReaderSecondary}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshShortcut" />
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut" />
      <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnAddShortcut" />
      <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnImportShortcut" />
      <KeyboardAccelerator Key="J" Invoked="OnNextShortcut" />
      <KeyboardAccelerator Key="K" Invoked="OnPreviousShortcut" />
      <KeyboardAccelerator Key="M" Invoked="OnReadShortcut" />
      <KeyboardAccelerator Key="S" Invoked="OnSaveShortcut" />
      <KeyboardAccelerator Key="F11" Invoked="OnFocusShortcut" />
      <KeyboardAccelerator Key="Escape" Invoked="OnEscapeShortcut" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="54" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="{StaticResource ReaderSidebar}">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="19,0,0,0" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE8F3;" FontSize="17" Foreground="{StaticResource ReaderAccent}" />
        <TextBlock Text="Unread" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ReaderForeground}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" BorderBrush="{StaticResource ReaderDivider}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
        <Button Style="{StaticResource ToolButton}" Click="OnToggleSidebar" ToolTipService.ToolTip="Show or hide sidebar" AutomationProperties.Name="Toggle sidebar"><FontIcon Glyph="&#xE700;" FontSize="17" /></Button>
        <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Click="OnRefresh" ToolTipService.ToolTip="Refresh feeds (Ctrl+R)" AutomationProperties.Name="Refresh feeds"><FontIcon Glyph="&#xE72C;" FontSize="18" /></Button>
        <Button x:Name="AddButton" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Add feeds, article links or OPML" AutomationProperties.Name="Add to library">
          <FontIcon Glyph="&#xE710;" FontSize="18" />
          <Button.Flyout><MenuFlyout>
            <MenuFlyoutItem Text="Add feed or website…" Click="OnAddFeed"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F3;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutItem Text="Save article link…" Click="OnAddArticle"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Import OPML…" Click="OnImportOpml"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutItem Text="Export OPML…" Click="OnExportOpml"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
          </MenuFlyout></Button.Flyout>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock x:Name="ViewTitle" Text="Unread Articles" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource ReaderForeground}" />
        <TextBlock x:Name="ViewSubtitle" Text="Demo library" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource ReaderSecondary}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,18,0" VerticalAlignment="Center">
        <Button x:Name="MarkAllReadButton" Style="{StaticResource ToolButton}" Click="OnMarkAllRead" ToolTipService.ToolTip="Mark displayed articles as read" AutomationProperties.Name="Mark displayed articles as read"><FontIcon Glyph="&#xE8FB;" FontSize="18" /></Button>
        <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Appearance" AutomationProperties.Name="Appearance">
          <FontIcon Glyph="&#xE790;" FontSize="18" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="16" Width="252" Padding="6">
                <TextBlock Text="Reading appearance" FontSize="17" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeChoice" Header="Theme" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" SelectedIndex="0">
                  <ComboBoxItem Content="Paper" /><ComboBoxItem Content="Dusk" /><ComboBoxItem Content="Campfire" />
                </ComboBox>
                <Slider x:Name="FontSlider" Header="Article text size" Minimum="16" Maximum="28" StepFrequency="1" Value="20" ValueChanged="OnFontChanged" />
                <ToggleSwitch x:Name="AutoReadToggle" Header="Mark as read when opened" IsOn="True" Toggled="OnAutoReadChanged" />
                <TextBlock Text="F11 hides the feed and article lists." TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <AutoSuggestBox x:Name="SearchBox" Width="228" PlaceholderText="Search loaded articles" TextChanged="OnSearchChanged" AutomationProperties.Name="Search loaded articles">
          <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>
      </StackPanel>
    </Grid>

    <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" />

    <Grid x:Name="PaneGrid" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="248" />
        <ColumnDefinition x:Name="SidebarDividerColumn" Width="8" />
        <ColumnDefinition x:Name="ListColumn" Width="390" />
        <ColumnDefinition x:Name="ListDividerColumn" Width="8" />
        <ColumnDefinition x:Name="ReaderColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="Sidebar" Background="{StaticResource ReaderSidebar}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DragLeave="OnSidebarViewportDragLeave">
          <StackPanel Margin="12,24,12,20" Spacing="3">
            <TextBlock Text="Articles" Margin="12,0,0,8" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ReaderSecondary}" />
            <ListView x:Name="MainNavigation" SelectionChanged="OnMainNavigation" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" SelectionMode="Single">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,1" /></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:NavigationItem">
                  <Border Background="{Binding Background}" CornerRadius="5" Padding="12,10">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{StaticResource ReaderAccent}" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="{StaticResource ReaderForeground}" />
                      <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="13" Foreground="{StaticResource ReaderAccent}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <Grid Background="Transparent" Margin="12,19,0,8" AllowDrop="True" DragOver="OnSidebarRootDragOver" DragLeave="OnSidebarRootDragLeave" Drop="OnSidebarRootDrop">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Subscriptions" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ReaderSecondary}" />
              <Button x:Name="NewFolderButton" Grid.Column="1" Style="{StaticResource ToolButton}" Click="OnNewFolder" AutomationProperties.Name="New folder" ToolTipService.ToolTip="New folder in local library"><FontIcon Glyph="&#xE8F4;" FontSize="16" /></Button>
            </Grid>
            <StackPanel x:Name="FeedNavigation" Spacing="2" Background="Transparent" AllowDrop="True" DragOver="OnSidebarRootDragOver" DragLeave="OnSidebarRootDragLeave" Drop="OnSidebarRootDrop" />
            <Border x:Name="SidebarRootDropTarget" Visibility="Collapsed" Background="{StaticResource ReaderSidebar}" BorderBrush="{StaticResource ReaderDivider}" BorderThickness="1" CornerRadius="5" Padding="10,14" Margin="0,8,0,0" AllowDrop="True" DragOver="OnSidebarRootDragOver" DragLeave="OnSidebarRootDragLeave" Drop="OnSidebarRootDrop">
              <TextBlock Text="Move to top level" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ReaderSecondary}" />
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{StaticResource ReaderDivider}" BorderThickness="0,1,0,0" Padding="12">
          <StackPanel Spacing="7">
            <Button x:Name="AccountButton" Click="OnAccount" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="10,8">
              <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE77B;" FontSize="17" Foreground="{StaticResource ReaderAccent}" />
                <TextBlock x:Name="AccountLabel" Grid.Column="1" Text="Connect Feedly" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="{StaticResource ReaderForeground}" />
                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource ReaderSecondary}" />
              </Grid>
            </Button>
            <TextBlock x:Name="SyncStatus" Text="Demo library · explore before connecting" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource ReaderSecondary}" Margin="10,0,4,2" />
          </StackPanel>
        </Border>
      </Grid>

      <local:PaneResizer x:Name="SidebarResizer" Grid.Column="1" Style="{StaticResource PaneResizerStyle}" ResizeRequested="OnPaneResize" AutomationProperties.Name="Sidebar width" AutomationProperties.HelpText="Drag or use Left and Right arrow keys to resize the sidebar and article list." ToolTipService.ToolTip="Resize sidebar · drag or use arrow keys" />

      <Grid x:Name="ArticleListPane" Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ListView x:Name="ArticleList" SelectionChanged="OnArticleSelected" IsItemClickEnabled="True" ItemClick="OnArticleActivated" ContainerContentChanging="OnArticleContainerChanging" ItemContainerStyle="{StaticResource ArticleContainer}" SelectionMode="Single" Padding="0,10,0,10" HorizontalContentAlignment="Stretch">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ArticleRow">
              <Border Background="{Binding Background}" BorderBrush="{Binding Divider}" BorderThickness="0,0,0,1" Padding="14,17" CornerRadius="6" Margin="0,2">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="7">
                    <TextBlock Text="{Binding Article.Title}" FontFamily="{StaticResource HeadlineFont}" FontSize="23" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground}" LineHeight="25" />
                    <TextBlock Text="{Binding Article.SourceLabel}" FontFamily="{StaticResource ReadingFont}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{Binding SourceForeground}" />
                    <TextBlock Text="{Binding Article.DateLabel}" FontSize="12" Foreground="{Binding SecondaryForeground}" />
                  </StackPanel>
                  <Border Grid.Column="1" Width="105" Height="78" VerticalAlignment="Top" CornerRadius="4" Visibility="{Binding ImageVisibility}">
                    <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="EmptyList" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="28" Visibility="Collapsed">
          <FontIcon Glyph="&#xE8FB;" FontSize="28" Foreground="{StaticResource ReaderAccent}" />
          <TextBlock x:Name="EmptyTitle" Text="You're all caught up." FontFamily="{StaticResource HeadlineFont}" FontSize="26" TextAlignment="Center" Foreground="{StaticResource ReaderForeground}" />
          <TextBlock x:Name="EmptyDescription" Text="A little room for something else." FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ReaderSecondary}" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource ReaderDivider}" BorderThickness="0,1,0,0" Padding="18,10">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ArticleCount" Text="" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource ReaderSecondary}" />
            <Button x:Name="LoadMoreButton" Grid.Column="1" Content="Load more" Click="OnLoadMore" Visibility="Collapsed" Padding="9,3" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ReaderAccent}" />
          </Grid>
        </Border>
      </Grid>

      <local:PaneResizer x:Name="ListResizer" Grid.Column="3" Style="{StaticResource PaneResizerStyle}" ResizeRequested="OnPaneResize" AutomationProperties.Name="Article list width" AutomationProperties.HelpText="Drag or use Left and Right arrow keys to resize the article list and reading pane." ToolTipService.ToolTip="Resize article list and reader · drag or use arrow keys" />

      <Grid x:Name="ReaderPane" Grid.Column="4">
        <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <Grid Margin="22,4,22,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Click="OnReaderBack" ToolTipService.ToolTip="Back to articles" AutomationProperties.Name="Back to articles" Visibility="Collapsed"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
            <Button x:Name="PreviousButton" Style="{StaticResource ToolButton}" Click="OnPrevious" ToolTipService.ToolTip="Previous article (K)" AutomationProperties.Name="Previous article"><FontIcon Glyph="&#xE70E;" FontSize="14" /></Button>
            <Button x:Name="NextButton" Style="{StaticResource ToolButton}" Click="OnNext" ToolTipService.ToolTip="Next article (J)" AutomationProperties.Name="Next article"><FontIcon Glyph="&#xE70D;" FontSize="14" /></Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <Button x:Name="ReadButton" Style="{StaticResource ToolButton}" Click="OnToggleRead" ToolTipService.ToolTip="Toggle read status (M)" AutomationProperties.Name="Toggle read status"><FontIcon x:Name="ReadIcon" Glyph="&#xEA3A;" FontSize="18" /></Button>
            <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Click="OnToggleSaved" ToolTipService.ToolTip="Save for later (S)" AutomationProperties.Name="Save for later"><FontIcon x:Name="SaveIcon" Glyph="&#xE734;" FontSize="19" /></Button>
            <Button x:Name="OpenBrowserButton" Style="{StaticResource ToolButton}" Click="OnOpenBrowser" ToolTipService.ToolTip="Open in browser" AutomationProperties.Name="Open article in browser"><FontIcon Glyph="&#xE8A7;" FontSize="17" /></Button>
            <Button x:Name="CopyLinkButton" Style="{StaticResource ToolButton}" Click="OnCopyLink" ToolTipService.ToolTip="Copy article link" AutomationProperties.Name="Copy article link"><FontIcon Glyph="&#xE8C8;" FontSize="16" /></Button>
            <Button Style="{StaticResource ToolButton}" Click="OnToggleFocus" ToolTipService.ToolTip="Focus reading (F11)" AutomationProperties.Name="Toggle focus reading"><FontIcon Glyph="&#xE740;" FontSize="16" /></Button>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ArticleContent" MaxWidth="820" HorizontalAlignment="Stretch" Margin="48,35,48,64" Spacing="0">
            <TextBlock x:Name="ArticleTitle" FontFamily="{StaticResource HeadlineFont}" FontSize="36" LineHeight="40" TextWrapping="Wrap" Foreground="{StaticResource ReaderForeground}" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="ArticleSource" Margin="0,24,0,0" TextWrapping="Wrap" FontFamily="{StaticResource ReadingFont}" FontSize="17" Foreground="{StaticResource ReaderAccent}" />
            <TextBlock x:Name="ArticleByline" Margin="0,5,0,0" FontFamily="{StaticResource ReadingFont}" FontSize="16" FontStyle="Italic" TextWrapping="Wrap" Foreground="{StaticResource ReaderSecondary}" />
            <StackPanel x:Name="ArticleBody" Margin="0,28,0,0" Spacing="19" />
            <Button x:Name="OriginalLink" Content="Continue on the original website" Click="OnOpenBrowser" Margin="0,28,0,0" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource ReaderAccent}" BorderThickness="0" Padding="0,8" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="ReaderEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="40" Visibility="Collapsed">
          <FontIcon Glyph="&#xE8F3;" FontSize="34" Foreground="{StaticResource ReaderSecondary}" />
          <TextBlock Text="A good place to read." FontFamily="{StaticResource HeadlineFont}" FontSize="30" Foreground="{StaticResource ReaderForeground}" />
          <TextBlock x:Name="ReaderEmptyDescription" Text="Choose an article to settle in." FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ReaderSecondary}" HorizontalAlignment="Center" />
          <StackPanel x:Name="EmptyLibraryActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0" Visibility="Collapsed">
            <Button Content="Add a feed" Click="OnAddFeed" />
            <Button Content="Import OPML" Click="OnImportOpml" />
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ReadingStatus" Grid.Row="2" Text="" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource ReaderSecondary}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
